{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Ross",
      "selected": true,
      "complex_modifications": {
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 200,
          "basic.to_if_held_down_threshold_milliseconds": 100
        },
        "rules": [
          {
            "description": "Logitech K350 special keys",
            "manipulators": [
              {
                "type": "basic",
                "from": { "consumer_key_code": "al_calculator" },
                "to": [{ "shell_command": "open -a Calculator" }]
              },
              {
                "type": "basic",
                "from": {
                  "consumer_key_code": "al_consumer_control_configuration",
                  "modifiers": { "optional": ["any"] }
                },
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 400 },
                "to": [{ "shell_command": "/Users/ross/.local/bin/spotify-popup" }],
                "to_if_held_down": [{ "shell_command": "/Users/ross/.local/bin/focus-app Firefox" }]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "al_image_browser" },
                "to": [
                  {
                    "key_code": "4",
                    "modifiers": ["left_command", "left_shift"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "ac_zoom_in" },
                "to": [
                  {
                    "key_code": "equal_sign",
                    "modifiers": ["left_command"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "ac_zoom_out" },
                "to": [
                  {
                    "key_code": "hyphen",
                    "modifiers": ["left_command"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "al_select_task_or_application" },
                "to": [
                  {
                    "key_code": "up_arrow",
                    "modifiers": ["left_control"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "stop" },
                "to": [{ "shell_command": "/opt/homebrew/bin/spotify_player playback play-pause" }]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "volume_increment" },
                "to": [{ "shell_command": "/opt/homebrew/bin/spotify_player playback volume --offset 5" }]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "volume_decrement" },
                "to": [{ "shell_command": "/opt/homebrew/bin/spotify_player playback volume --offset -5" }]
              },
              {
                "type": "basic",
                "from": { "consumer_key_code": "mute" },
                "to": [{ "shell_command": "/Users/ross/.local/bin/spotify-mute" }]
              }
            ]
          },
          {
            "description": "Caps Lock: Hyper (Ctrl+Opt+Cmd) when held, Escape when tapped",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": ["left_option", "left_command"]
                  }
                ],
                "to_if_alone": [{ "key_code": "escape" }]
              }
            ]
          }
        ]
      },
      "devices": [
