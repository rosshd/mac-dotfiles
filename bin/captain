#!/usr/bin/env bash
# captain: keyboard-first command deck for Ross's AI workflow.
set -euo pipefail

PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
if [ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
if [ -d /run/current-system/sw/bin ]; then
  PATH="/run/current-system/sw/bin:$PATH"
fi

usage() {
  cat <<'USAGE'
usage:
  captain status
  captain phone-status
  captain dispatch [--start] [--agent codex|claude] [--ship reviewed-branch|green-pr|committed-branch] <dictated task...>
  captain watch [seconds]
  captain brief <slug>
  captain start <slug> [fleet options] [objective...]
  captain done <worktree-path>
  captain review <intent...>
  captain station [title] [message]
  captain voice
  captain phone-host
  captain tools

The captain loop is:
  brief -> fleet start -> captain status/watch -> no-mistakes gate -> review/merge.

Use this command when Ross is acting as captain.
Agents do implementation, testing, and review; Ross handles product decisions and gates.
USAGE
}

section() {
  printf '\n== %s ==\n' "$1"
}

strip_ansi() {
  if command -v perl >/dev/null 2>&1; then
    perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g'
  else
    cat
  fi
}

shorten() {
  local value="$1"
  local max="${2:-28}"
  if [ "${#value}" -le "$max" ]; then
    printf '%s\n' "$value"
  elif [ "$max" -le 3 ]; then
    printf '%.*s\n' "$max" "$value"
  else
    printf '%.*s...\n' "$((max - 3))" "$value"
  fi
}

wrap_value() {
  local prefix="$1"
  local value="$2"
  local width="${3:-24}"
  local indent="${4:-   }"

  if [ -z "$value" ]; then
    printf '%s\n' "$prefix"
    return 0
  fi

  local chunk
  chunk="${value:0:$width}"
  value="${value:$width}"
  if [ -n "$value" ] && [[ "$chunk" == *[-,]* ]]; then
    local split_char="-"
    [[ "$chunk" == *,* ]] && split_char=","
    local before="${chunk%$split_char*}$split_char"
    local after="${chunk##*$split_char}"
    if [ "${#before}" -ge 8 ]; then
      chunk="$before"
      value="$after$value"
    fi
  fi
  printf '%s%s\n' "$prefix" "$chunk"
  while [ -n "$value" ]; do
    while [[ "$value" == " "* ]]; do
      value="${value# }"
    done
    while [[ "$value" == ","* ]]; do
      value="${value#,}"
      value="${value# }"
    done
    chunk="${value:0:$width}"
    value="${value:$width}"
    if [ -n "$value" ] && [[ "$chunk" == *[-,]* ]]; then
      local split_char="-"
      [[ "$chunk" == *,* ]] && split_char=","
      local before="${chunk%$split_char*}$split_char"
      local after="${chunk##*$split_char}"
      if [ "${#before}" -ge 8 ]; then
        chunk="$before"
        value="$after$value"
      fi
    fi
    printf '%s%s\n' "$indent" "$chunk"
  done
}

short_gh_status() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "missing gh"
    return 0
  fi
  # Credential presence is the durable auth signal. `gh auth status` may
  # contact GitHub and used to turn transient network failures into false
  # "login required" alerts, especially from iPhone SSH shortcuts.
  if gh auth token >/dev/null 2>&1; then
    echo "ok gh credentials configured"
  else
    echo "needs attention: gh login required"
  fi
}

default_branch_for_root() {
  local root="$1"
  local ref
  ref="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then
    printf '%s\n' "${ref#origin/}"
  elif git -C "$root" show-ref --verify --quiet refs/heads/main; then
    printf 'main\n'
  elif git -C "$root" show-ref --verify --quiet refs/heads/master; then
    printf 'master\n'
  else
    git -C "$root" branch --show-current 2>/dev/null || true
  fi
}

repo_needs_gate() {
  local root="$1"
  local branch default_branch changes ahead="0"
  branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
  default_branch="$(default_branch_for_root "$root")"
  changes="$(git -C "$root" status --short 2>/dev/null || true)"
  if git -C "$root" rev-parse --verify '@{upstream}' >/dev/null 2>&1; then
    ahead="$(git -C "$root" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)"
  fi
  [ -n "$changes" ] || [ -z "$branch" ] || [ "$branch" != "$default_branch" ] || [ "$ahead" -gt 0 ]
}

no_mistakes_updated_epoch() {
  local run_id="$1"
  local db="$HOME/.no-mistakes/state.sqlite"
  [[ "$run_id" =~ ^[0-9A-Z]+$ ]] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  [ -f "$db" ] || return 0
  sqlite3 "$db" "select updated_at from runs where id = '$run_id' limit 1;" 2>/dev/null || true
}

classify_no_mistakes() {
  local status="$1"
  local run_branch="$2"
  local run_head="$3"
  local current_branch="$4"
  local current_head="$5"
  local needs_gate="$6"
  local updated_epoch="${7:-0}"
  local now="${8:-$(date +%s)}"
  local findings="${9:-}"
  local failed_step="${10:-}"
  local age=0 age_label="unknown" matches_current="false"
  local max_age="${CAPTAIN_NO_MISTAKES_MAX_AGE_SECONDS:-259200}"
  local stuck_age="${CAPTAIN_NO_MISTAKES_STUCK_SECONDS:-1200}"

  if [ "$updated_epoch" -gt 0 ] 2>/dev/null; then
    if [ "$updated_epoch" -gt "$((now * 100))" ]; then
      updated_epoch="$((updated_epoch / 1000))"
    fi
    age="$((now - updated_epoch))"
    [ "$age" -lt 0 ] && age=0
    age_label="$(format_age "$age") ago"
  fi

  if [ -n "$run_branch" ] && [ -n "$run_head" ] && [ -n "$current_head" ] &&
    [ "$run_branch" = "$current_branch" ] &&
    { [[ "$current_head" == "$run_head"* ]] || [[ "$run_head" == "$current_head"* ]]; }; then
    matches_current="true"
  fi

  if [ -z "$status" ] || [ "$status" = "unknown" ]; then
    if [ "$needs_gate" = "true" ]; then
      printf 'needed|needed|current work has not been checked|Run no-mistakes\n'
    else
      printf 'idle|idle|no validation needed|\n'
    fi
    return 0
  fi

  case "$status" in
    completed|failed|aborted|cancelled|canceled) ;;
    awaiting*|blocked|paused)
      if [ "$updated_epoch" -gt 0 ] && [ "$age" -ge "$stuck_age" ]; then
        printf 'stuck|stuck|%s, no update for %s|Check no-mistakes\n' "$run_branch" "$age_label"
      else
        printf 'waiting|waiting|%s, updated %s|Check no-mistakes\n' "$run_branch" "$age_label"
      fi
      return 0
      ;;
    *)
      if [ "$updated_epoch" -gt 0 ] && [ "$age" -ge "$stuck_age" ]; then
        printf 'stuck|stuck|%s, no update for %s|Check no-mistakes\n' "$run_branch" "$age_label"
      else
        printf 'running|running|%s, updated %s|\n' "$run_branch" "$age_label"
      fi
      return 0
      ;;
  esac

  if [ "$matches_current" = "true" ] &&
    { [ "$updated_epoch" -eq 0 ] || [ "$age" -lt "$max_age" ]; }; then
    if [ "$status" = "completed" ]; then
      if [ -n "$findings" ] && [ "$findings" != "none" ]; then
        printf 'review|review|findings: %s|Review no-mistakes findings\n' "$findings"
      else
        printf 'passed|passed|validated %s|\n' "$age_label"
      fi
    else
      printf 'failed|failed|%s%s|No-mistakes failed\n' \
        "${failed_step:-run}" "${age_label:+, $age_label}"
    fi
    return 0
  fi

  if [ "$needs_gate" = "true" ]; then
    printf 'needed|needed|current work has not been checked|Run no-mistakes\n'
  else
    printf 'idle|idle|no validation needed|\n'
  fi
}

no_mistakes_info() {
  local root="$1"
  if ! command -v no-mistakes >/dev/null 2>&1; then
    printf 'missing|missing|not installed|Install no-mistakes\n'
    return 0
  fi

  local out run_id run_branch run_head run_status findings failed_step updated_epoch
  local current_branch current_head needs_gate="false"
  out="$(cd "$root" && no-mistakes axi status 2>&1 || true)"
  out="$(printf '%s\n' "$out" | strip_ansi)"
  run_id="$(printf '%s\n' "$out" | awk -F': ' '/^[[:space:]]*id:/ { gsub(/"/, "", $2); print $2; exit }')"
  run_branch="$(printf '%s\n' "$out" | awk -F': ' '/^[[:space:]]*branch:/ { gsub(/"/, "", $2); print $2; exit }')"
  run_status="$(printf '%s\n' "$out" | awk -F': ' '/^[[:space:]]*status:/ { print $2; exit }')"
  run_head="$(printf '%s\n' "$out" | awk -F': ' '/^[[:space:]]*head:/ { print $2; exit }')"
  findings="$(printf '%s\n' "$out" | awk -F': ' '/^[[:space:]]*findings:/ { print $2; exit }')"
  failed_step="$(printf '%s\n' "$out" | awk -F',' '$2 == "failed" { print $1; exit }' | sed 's/^[[:space:]]*//')"
  updated_epoch="$(no_mistakes_updated_epoch "$run_id")"
  current_branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
  current_head="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  repo_needs_gate "$root" && needs_gate="true"

  classify_no_mistakes \
    "${run_status:-unknown}" "$run_branch" "$run_head" \
    "$current_branch" "$current_head" "$needs_gate" \
    "${updated_epoch:-0}" "$(date +%s)" "$findings" "$failed_step"
}

short_no_mistakes_status() {
  local root info state label detail attention
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  info="$(no_mistakes_info "$root")"
  IFS='|' read -r state label detail attention <<< "$info"
  printf '%s\n' "$label"
  [ -n "$detail" ] && printf '  %s\n' "$detail"
}

short_treehouse_status() {
  if ! command -v treehouse >/dev/null 2>&1; then
    echo "missing treehouse"
    return 0
  fi
  treehouse status 2>&1 | strip_ansi | sed -n '1,80p' || true
}

short_repro_status() {
  local dotfiles="$HOME/mac-dotfiles"
  if [ -f "$dotfiles/Brewfile" ] && command -v brew >/dev/null 2>&1; then
    if HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file "$dotfiles/Brewfile" --no-upgrade >/tmp/captain-brew.out 2>&1; then
      echo "brew ok"
    else
      echo "brew drift"
    fi
  else
    echo "brewfile miss"
  fi

  if [ -f "$dotfiles/flake.nix" ]; then
    if command -v darwin-rebuild >/dev/null 2>&1; then
      echo "nix active"
    elif command -v nix >/dev/null 2>&1; then
      echo "nix ready"
    else
      echo "nix plan"
    fi
  else
    echo "nix miss"
  fi

  if command -v herdr >/dev/null 2>&1; then
    echo "herdr ok"
  else
    echo "herdr hold"
  fi
}

format_age() {
  local seconds="${1:-0}"
  if [ "$seconds" -lt 60 ]; then
    printf '%ss\n' "$seconds"
  elif [ "$seconds" -lt 3600 ]; then
    printf '%sm\n' "$((seconds / 60))"
  elif [ "$seconds" -lt 86400 ]; then
    printf '%sh\n' "$((seconds / 3600))"
  else
    printf '%sd\n' "$((seconds / 86400))"
  fi
}

fleet_slugs() {
  local root="$1"
  {
    if command -v tmux >/dev/null 2>&1; then
      tmux list-windows -a -F '#{window_name}' 2>/dev/null |
        awk '/^fleet-/ { sub(/^fleet-/, ""); print }'
    fi

    git -C "$root" worktree list --porcelain 2>/dev/null |
      awk '$1 == "branch" && $2 ~ /^refs\/heads\/fleet\// {
        sub(/^refs\/heads\/fleet\//, "", $2)
        print $2
      }'

    local path
    for path in "$root"/.artifacts/fleet/*.worktree; do
      [ -f "$path" ] || continue
      basename "$path" .worktree
    done
  } | sed '/^$/d' | sort -u
}

fleet_worktree_for_slug() {
  local root="$1"
  local slug="$2"
  local path_file="$root/.artifacts/fleet/$slug.worktree"
  local worktree=""

  if [ -f "$path_file" ]; then
    worktree="$(sed -n '1p' "$path_file")"
    if [ -n "$worktree" ] && [ -d "$worktree" ]; then
      printf '%s\n' "$worktree"
      return 0
    fi
  fi

  git -C "$root" worktree list --porcelain 2>/dev/null |
    awk -v branch="refs/heads/fleet/$slug" '
      $1 == "worktree" { path = $2 }
      $1 == "branch" && $2 == branch { print path; exit }
    '
}

latest_gnhf_log() {
  local worktree="$1"
  local latest=""
  local latest_mtime="0"
  local log mtime

  while IFS= read -r log; do
    mtime="$(stat -f '%m' "$log" 2>/dev/null || echo 0)"
    if [ "$mtime" -gt "$latest_mtime" ]; then
      latest="$log"
      latest_mtime="$mtime"
    fi
  done < <(find "$worktree/.gnhf/runs" -mindepth 2 -maxdepth 2 -name gnhf.log -type f 2>/dev/null)

  printf '%s\n' "$latest"
}

fleet_run_info() {
  local root="$1"
  local slug="$2"
  local worktree log end_line abort_line run_line status reason
  local iterations commits pid age mtime state detail
  local review_file review_line review_state review_head current_head ship_file ship
  local gate_info gate_state gate_label gate_detail gate_attention

  worktree="$(fleet_worktree_for_slug "$root" "$slug")"
  if [ -z "$worktree" ] || [ ! -d "$worktree" ]; then
    printf 'stale|missing worktree\n'
    return 0
  fi

  log="$(latest_gnhf_log "$worktree")"
  if [ -z "$log" ]; then
    printf 'idle|no GNHF run log\n'
    return 0
  fi

  end_line="$(grep '"event":"orchestrator:end"' "$log" | tail -n 1 || true)"
  abort_line="$(grep '"event":"orchestrator:abort"' "$log" | tail -n 1 || true)"

  if [ -n "$end_line" ]; then
    status="$(printf '%s\n' "$end_line" | jq -r '.status // "unknown"' 2>/dev/null)"
    iterations="$(printf '%s\n' "$end_line" | jq -r '.iterations // 0' 2>/dev/null)"
    commits="$(printf '%s\n' "$end_line" | jq -r '.commitCount // 0' 2>/dev/null)"
    reason="$(printf '%s\n' "$abort_line" | jq -r '.reason // empty' 2>/dev/null)"

    if [ "$status" = "completed" ] || [ "$reason" = "stop condition met" ]; then
      state="ready"
      detail="$commits commits, $iterations iterations"
    elif [[ "$reason" == max\ iterations* ]]; then
      state="capped"
      detail="$commits commits, $iterations iterations, $reason"
    elif [[ "$reason" == *consecutive\ failures* ]]; then
      state="failed"
      detail="$commits commits, $iterations iterations, $reason"
    else
      state="failed"
      detail="$commits commits, $iterations iterations${reason:+, $reason}"
    fi

    review_file="$root/.artifacts/fleet/$slug.review-status"
    if [ "$state" != "ready" ] && [ -f "$review_file" ]; then
      review_line="$(sed -n '1p' "$review_file")"
      IFS='|' read -r review_state review_head mtime <<< "$review_line"
      current_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$review_head" ] && [ "$review_head" = "$current_head" ]; then
        case "$review_state" in
          reviewed)
            state="reviewed"; detail="$detail, recovered by independent local review" ;;
          passed)
            state="ship-ready"; detail="$detail, recovered by independent shipping gate" ;;
        esac
      fi
    fi

    review_file="$root/.artifacts/fleet/$slug.review-status"
    if [ "$state" = "ready" ] && [ -f "$review_file" ]; then
      review_line="$(sed -n '1p' "$review_file")"
      IFS='|' read -r review_state review_head mtime <<< "$review_line"
      current_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
      ship_file="$root/.artifacts/fleet/$slug.ship"
      ship="$(sed -n '1p' "$ship_file" 2>/dev/null || true)"
      gate_info="$(no_mistakes_info "$worktree")"
      IFS='|' read -r gate_state gate_label gate_detail gate_attention <<< "$gate_info"
      case "$gate_state" in
        running) state="reviewing"; detail="$detail, no-mistakes running" ;;
        waiting|stuck) state="review-needed"; detail="$detail, no-mistakes needs a decision" ;;
        failed|review) state="review-failed"; detail="$detail, no-mistakes needs attention" ;;
        passed)
          if [ "$ship" = "green-pr" ]; then
            state="ship-ready"; detail="$detail, independent gate passed"
          else
            state="reviewed"; detail="$detail, independent local gate passed"
          fi
          ;;
        needed)
          if [ -z "$review_head" ] || [ "$review_head" != "$current_head" ]; then
            state="review-needed"; detail="$detail, current HEAD is not reviewed"
          fi
          ;;
      esac
      if [ "$state" = "ready" ] && [ -n "$review_head" ] && [ "$review_head" = "$current_head" ]; then
        case "$review_state" in
          reviewing) state="reviewing"; detail="$detail, no-mistakes running" ;;
          waiting) state="review-needed"; detail="$detail, no-mistakes needs a decision" ;;
          failed) state="review-failed"; detail="$detail, no-mistakes failed" ;;
          reviewed) state="reviewed"; detail="$detail, independent local gate passed" ;;
          passed) state="ship-ready"; detail="$detail, independent gate passed" ;;
        esac
      fi
    fi

    printf '%s|%s\n' "$state" "$detail"
    return 0
  fi

  run_line="$(grep '"event":"run:start"' "$log" | tail -n 1 || true)"
  pid="$(printf '%s\n' "$run_line" | jq -r '.pid // 0' 2>/dev/null)"
  run_line="$(grep '"event":"iteration:start"' "$log" | tail -n 1 || true)"
  iterations="$(printf '%s\n' "$run_line" | jq -r '.iteration // 0' 2>/dev/null)"
  commits="$(printf '%s\n' "$run_line" | jq -r '.git.commitCount // 0' 2>/dev/null)"
  mtime="$(stat -f '%m' "$log" 2>/dev/null || echo 0)"
  age="$(( $(date +%s) - mtime ))"
  [ "$age" -lt 0 ] && age=0

  if [ "$pid" -gt 0 ] && kill -0 "$pid" 2>/dev/null; then
    if [ "$age" -ge "${CAPTAIN_FLEET_STUCK_SECONDS:-1200}" ]; then
      state="stuck"
    else
      state="running"
    fi
    detail="$commits commits, iteration $iterations, quiet $(format_age "$age")"
  else
    state="orphaned"
    detail="$commits commits, iteration $iterations, process exited"
  fi

  printf '%s|%s\n' "$state" "$detail"
}

fleet_status_rows() {
  local root="$1"
  local slug info state detail
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    info="$(fleet_run_info "$root" "$slug")"
    state="${info%%|*}"
    detail="${info#*|}"
    printf '%s|%s|%s\n' "$slug" "$state" "$detail"
  done < <(fleet_slugs "$root")
}

short_fleet_windows() {
  local root rows slug state detail
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  rows="$(fleet_status_rows "$root")"
  if [ -n "$rows" ]; then
    while IFS='|' read -r slug state detail; do
      printf '  %s [%s] %s\n' "$slug" "$state" "$detail"
    done <<< "$rows"
  else
    echo "  none"
  fi
}

repo_root() {
  git rev-parse --show-toplevel
}

slugify() {
  printf '%s\n' "$*" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g' |
    cut -c 1-42 |
    sed -E 's/-+$//'
}

status() {
  section "captain"
  printf 'cwd: %s\n' "$(pwd)"
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    printf 'repo: %s\n' "$(git rev-parse --show-toplevel)"
    printf 'branch: %s\n' "$(git branch --show-current 2>/dev/null || true)"
    local changes
    changes="$(git status --short 2>/dev/null || true)"
    if [ -n "$changes" ]; then
      echo "$changes" | sed 's/^/  /'
    else
      echo "  clean"
    fi
  else
    echo "repo: none"
  fi

  section "fleets"
  short_fleet_windows

  section "treehouse"
  short_treehouse_status

  section "no-mistakes"
  short_no_mistakes_status

  section "github"
  short_gh_status

  section "reproducibility"
  short_repro_status

  section "voice"
  if [ -d /Applications/OpenSuperWhisper.app ]; then
    echo "ok OpenSuperWhisper installed"
  else
    echo "missing OpenSuperWhisper"
  fi
}

phone_status() {
  local repo_name="no repo"
  local branch="none"
  local git_state="not a git repo"
  local changes=""
  local now

  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo_name="$(basename "$(git rev-parse --show-toplevel)")"
    branch="$(git branch --show-current 2>/dev/null || true)"
    branch="${branch:-detached}"
    changes="$(git status --short 2>/dev/null || true)"
    if [ -n "$changes" ]; then
      git_state="$(printf '%s\n' "$changes" | wc -l | tr -d ' ') changed"
    else
      git_state="clean"
    fi
  fi

  now="$(date '+%b %-d  %-I:%M %p')"

  local attention=()
  local fleet_count="0"
  local fleet_rows=""
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  fleet_rows="$(fleet_status_rows "$root")"
  if [ -n "$fleet_rows" ]; then
    fleet_count="$(printf '%s\n' "$fleet_rows" | wc -l | tr -d ' ')"
    while IFS='|' read -r slug state detail; do
      case "$state" in
        ready) attention+=("Review $(shorten "$slug" 18)") ;;
        reviewing) ;;
        review-needed) attention+=("Review gate $(shorten "$slug" 18)") ;;
        review-failed) attention+=("Review failed $(shorten "$slug" 18)") ;;
        reviewed) attention+=("Decide $(shorten "$slug" 18)") ;;
        ship-ready) attention+=("Merge $(shorten "$slug" 18)") ;;
        capped) attention+=("Capped $(shorten "$slug" 18)") ;;
        failed) attention+=("Failed $(shorten "$slug" 18)") ;;
        stuck) attention+=("Stuck $(shorten "$slug" 18)") ;;
        orphaned) attention+=("Orphaned $(shorten "$slug" 18)") ;;
        stale) attention+=("Close stale $(shorten "$slug" 18)") ;;
        idle|untracked) attention+=("Set up $(shorten "$slug" 18)") ;;
      esac
    done <<< "$fleet_rows"
  fi

  local gate_line="no-mistakes missing"
  local gate_detail=""
  local gate_info gate_state gate_label gate_attention
  gate_info="$(no_mistakes_info "$root")"
  IFS='|' read -r gate_state gate_label gate_detail gate_attention <<< "$gate_info"
  gate_line="no-mistakes $gate_label"
  [ -n "$gate_attention" ] && attention+=("$gate_attention")

  local treehouse_line="tree miss"
  if command -v treehouse >/dev/null 2>&1; then
    local th
    th="$(treehouse status 2>&1 || true)"
    th="$(printf '%s\n' "$th" | strip_ansi)"
    if printf '%s\n' "$th" | grep -qi 'No worktrees in pool'; then
      treehouse_line="treehouse clear"
    elif printf '%s\n' "$th" | grep -qi 'operation not permitted'; then
      treehouse_line="treehouse sandbox"
    elif printf '%s\n' "$th" | grep -q '[[:space:]]available[[:space:]]'; then
      local th_free
      th_free="$(printf '%s\n' "$th" | awk '$2 == "available" { count++ } END { print count + 0 }')"
      treehouse_line="treehouse ${th_free} free"
    else
      local th_first
      th_first="$(printf '%s\n' "$th" | sed -n '1p')"
      treehouse_line="$(shorten "$th_first" 22)"
    fi
  fi

  local gh_line="gh missing"
  if ! command -v gh >/dev/null 2>&1; then
    attention+=("Install GitHub CLI")
  elif gh auth token >/dev/null 2>&1; then
    gh_line="github configured"
  else
    gh_line="github login"
    attention+=("GitHub login")
  fi
  local voice_line="voice missing"
  if [ -d /Applications/OpenSuperWhisper.app ]; then
    voice_line="voice installed"
  fi
  local repro_line
  repro_line="$(short_repro_status | awk 'BEGIN { sep="" } { printf "%s%s", sep, $0; sep=" · " }')"

  printf '🐉  CAPTAIN DECK  ✦ %s\n' "$(shorten "$repo_name" 18)"
  printf '◆ %s\n' "$now"
  printf '━━━━━━━━━━━━\n'
  wrap_value '🛡  ' "$branch" 26 '   '
  printf '✦ git %s · gate %s\n' "$git_state" "$(shorten "${gate_line#no-mistakes }" 12)"
  printf '⚔  fleets %s\n' "$fleet_count"
  if [ -n "$fleet_rows" ]; then
    while IFS='|' read -r slug state detail; do
      printf '   %-8s %s\n' "$state" "$(shorten "$slug" 20)"
      wrap_value '     ' "$detail" 26 '     '
    done <<< "$fleet_rows"
  fi
  if [ -n "$gate_detail" ]; then
    wrap_value '🔥 ' "$gate_detail" 25 '   '
  fi
  wrap_value '⚙  ' "$repro_line" 33 '   '
  printf '🏰 %s · %s · %s\n' "$treehouse_line" "$gh_line" "$voice_line"
  printf '━━━━━━━━━━━━\n'
  if [ "${#attention[@]}" -eq 0 ]; then
    printf 'Needs you: nothing urgent\n'
  else
    printf 'Needs you:\n'
    local item
    for item in "${attention[@]}"; do
      printf '   • %s\n' "$item"
    done
  fi
}

phone_host() {
  printf 'Mac SSH host options\n'
  printf 'LocalHostName: %s\n' "$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
  if command -v tailscale >/dev/null 2>&1; then
    tailscale status --self 2>/dev/null || true
  elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
    echo "Tailscale app installed."
    echo "Use the Tailscale app device name or MagicDNS hostname in Shortcuts."
  else
    echo "Tailscale is missing."
    echo "Install the Tailscale app and sign in on the Mac."
  fi
  echo
  echo "Prefer the Tailscale MagicDNS hostname in iPhone Shortcuts."
  echo "Use the raw 100.x address only as a fallback."
}

watch_status() {
  local delay="${1:-5}"
  while true; do
    clear
    date '+%Y-%m-%d %H:%M:%S'
    status
    printf '\n[captain] refresh every %ss - Ctrl-C to exit\n' "$delay"
    sleep "$delay"
  done
}

voice() {
  if [ -d /Applications/OpenSuperWhisper.app ]; then
    open -a OpenSuperWhisper >/dev/null 2>&1 || true
    echo "Opened OpenSuperWhisper."
    echo "Use it for dictating rich prompts into Codex, fleet briefs, and planning notes."
  else
    echo "OpenSuperWhisper is not installed."
    echo "Install path expected: /Applications/OpenSuperWhisper.app"
  fi
  echo
  voice-vocab 2>/dev/null || true
}

station() {
  local title="${1:-Captain needed}"
  local message="${2:-An agent station needs attention}"
  notify --priority urgent --tag rotating_light --sound Glass --volume loud --repeat 2 "$title" "$message"
}

review() {
  if [ "$#" -eq 0 ]; then
    echo "usage: captain review <intent...>" >&2
    exit 2
  fi
  no-mistakes axi run --intent "$*"
}

dispatch() {
  local start=0
  local agent="codex"
  local ship="reviewed-branch"
  local args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run|--preview) start=0; shift ;;
      --start|--go|--yes) start=1; shift ;;
      --agent) agent="${2:?}"; shift 2 ;;
      --ship) ship="${2:?}"; shift 2 ;;
      --) shift; args+=("$@"); break ;;
      *) args+=("$1"); shift ;;
    esac
  done

  local task
  task="${args[*]}"
  if [ -z "$task" ] && [ ! -t 0 ]; then
    task="$(cat)"
  fi
  task="$(printf '%s\n' "$task" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  if [ -z "$task" ]; then
    echo "usage: captain dispatch <dictated task...>" >&2
    exit 2
  fi

  local root repo slug_base slug path
  root="$(repo_root)"
  repo="$(basename "$root")"
  slug_base="$(slugify "$task")"
  slug_base="${slug_base:-phone-task}"
  slug="$(date '+phone-%m%d-%H%M')-$slug_base"
  path="$root/.artifacts/fleet/$slug.md"

  printf '🐉 Dispatch preview\n'
  printf 'repo: %s\n' "$repo"
  printf 'slug: %s\n' "$slug"
  printf 'agent: %s\n' "$agent"
  printf 'ship: %s\n' "$ship"
  printf 'task: %s\n' "$(shorten "$task" 80)"

  if [ "$start" -eq 0 ]; then
    printf '\nNot started.\n'
    printf 'Run again with --start to create the worktree.\n'
    return 0
  fi

  if [ "$start" -eq 1 ]; then
    mkdir -p "$(dirname "$path")"
    cat > "$path" <<BRIEF
# Fleet Brief: $slug

## Objective

$task

## Source

Phone voice dispatch through \`captain dispatch\`.

## Scope

In:
- Implement the requested task end to end.
- Follow the closest AGENTS.md instructions.
- Preserve existing behavior unless the objective explicitly requires a change.
- Keep changes scoped to the requested outcome.

Out:
- Unrelated refactors.
- Dependency churn unless required.
- Product decisions that were not stated in the request.

## Verification

- Reproduce or understand the user-visible behavior before patching when this is a bug.
- Run the narrow relevant check first.
- Run the repo green gate before calling the work complete.
- For openlearn, use \`make check\`.

## Escalation

Stop and report back instead of guessing when:
- The task needs a product/design decision.
- The implementation would require risky permissions, secrets, credentials, or destructive commands.
- The requested behavior conflicts with AGENTS.md or repo constraints.
- The green gate fails after one focused fix attempt.

## Stop condition

The requested outcome is implemented, relevant verification passes, and a concise handoff explains changed files, verification, risks, and the next decision Ross needs to make.
Set `should_fully_stop=true` when those outcomes are complete after this iteration's work.
GNHF commits successful iteration changes automatically after the response, so do not wait for the commit to exist and do not commit manually.
BRIEF
  fi

  printf '\nStarted.\n'

  (cd "$root" && fleet start "$slug" --agent "$agent" --ship "$ship")
}

tools() {
  for cmd in codex claude opencode herdr treehouse gnhf no-mistakes lavish-axi firstmate fleet notify voice-vocab rebuild-mac gh tmux nvim; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf 'ok   %-16s %s\n' "$cmd" "$(command -v "$cmd")"
    else
      printf 'miss %-16s\n' "$cmd"
    fi
  done
}

if [ "${CAPTAIN_SOURCE_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

cmd="${1:-status}"
shift || true

case "$cmd" in
  status)
    if [ "${1:-}" = "--phone" ]; then
      phone_status
    else
      status
    fi
    ;;
  phone-status|phone) phone_status ;;
  watch) watch_status "${1:-5}" ;;
  brief) fleet brief "$@" ;;
  start) fleet start "$@" ;;
  done) fleet done "$@" ;;
  review) review "$@" ;;
  dispatch|phone-dispatch) dispatch "$@" ;;
  station|notify) station "$@" ;;
  voice|dictate) voice ;;
  phone-host|host) phone_host ;;
  tools|doctor) tools ;;
  -h|--help|help) usage ;;
  *)
    echo "unknown captain command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
