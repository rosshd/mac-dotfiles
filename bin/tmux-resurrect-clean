#!/usr/bin/env bash
set -euo pipefail

file="${1:-}"
[ -n "$file" ] && [ -f "$file" ] || exit 0

tmp="$(mktemp "${TMPDIR:-/tmp}/tmux-resurrect-clean.XXXXXX")"
awk -F '\t' '
  $1 == "pane" || $1 == "window" || $1 == "state" || $1 == "grouped_session" {
    print
  }
' "$file" > "$tmp"
mv "$tmp" "$file"
