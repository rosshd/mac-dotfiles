#!/usr/bin/env python3
"""Audit local agent workflow health without changing state."""

from __future__ import annotations

import argparse
import hashlib
import os
import shutil
import subprocess
from pathlib import Path


class Report:
    def __init__(self) -> None:
        self.failures = 0
        self.warnings = 0

    def ok(self, message: str) -> None:
        print(f"ok   {message}")

    def warn(self, message: str) -> None:
        self.warnings += 1
        print(f"warn {message}")

    def fail(self, message: str) -> None:
        self.failures += 1
        print(f"fail {message}")


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def directory_size(path: Path) -> int:
    total = 0
    if not path.exists():
        return total
    for current, directories, files in os.walk(path):
        directories[:] = [
            name for name in directories if not Path(current, name).is_symlink()
        ]
        for name in files:
            file_path = Path(current, name)
            try:
                total += file_path.stat().st_size
            except OSError:
                pass
    return total


def discover_repositories(root: Path) -> list[Path]:
    repositories = []
    if not root.exists():
        return repositories
    for current, directories, _files in os.walk(root):
        current_path = Path(current)
        depth = len(current_path.relative_to(root).parts)
        directories[:] = [
            name
            for name in directories
            if name not in {".venv", "node_modules", ".cache", "Library"} and depth < 5
        ]
        if ".git" in directories or (current_path / ".git").is_file():
            repositories.append(current_path)
            if ".git" in directories:
                directories.remove(".git")
    return sorted(set(repositories))


def command_ok(command: list[str]) -> bool:
    try:
        return (
            subprocess.run(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            ).returncode
            == 0
        )
    except (OSError, subprocess.TimeoutExpired):
        return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--home", default=os.environ.get("HOME", str(Path.home())))
    parser.add_argument("--skip-git", action="store_true")
    args = parser.parse_args()
    home = Path(args.home).expanduser().resolve()
    report = Report()

    print("== discovery ==")
    agents = home / "agents"
    expected_agents = home / "mac-dotfiles" / "agents"
    if agents.is_symlink() and agents.resolve() == expected_agents.resolve():
        report.ok("~/agents points to mac-dotfiles")
    else:
        report.fail("~/agents is not the canonical mac-dotfiles agent workspace")

    for relative in [
        ".codex/AGENTS.md",
        ".claude/CLAUDE.md",
        ".config/opencode/AGENTS.md",
        ".copilot/copilot-instructions.md",
        ".gemini/GEMINI.md",
    ]:
        path = home / relative
        if path.exists():
            report.ok(relative)
        else:
            report.fail(f"{relative} is missing")

    print("\n== skills ==")
    skill_roots = [home / ".agents/skills", home / ".codex/skills", agents / "skills"]
    by_name: dict[str, list[tuple[Path, str]]] = {}
    for skill_root in skill_roots:
        if not skill_root.exists():
            continue
        for skill_file in skill_root.glob("*/SKILL.md"):
            by_name.setdefault(skill_file.parent.name, []).append(
                (skill_file, digest(skill_file))
            )
    divergent = 0
    for name, copies in sorted(by_name.items()):
        hashes = {item[1] for item in copies}
        if len(hashes) > 1:
            divergent += 1
            report.warn(f"skill '{name}' has {len(hashes)} divergent copies")
    if not divergent:
        report.ok("no divergent skill copies")

    print("\n== networking ==")
    networking_home = home / "networking"
    if shutil.which("networking") and command_ok(
        ["networking", "--home", str(networking_home), "doctor"]
    ):
        report.ok("networking CLI and workspace")
    else:
        report.fail("networking CLI or workspace doctor failed")
    raycast = home / "Library/Application Support/Raycast/scripts/networking-capture.sh"
    if raycast.exists():
        report.ok("Raycast networking capture")
    else:
        report.warn("Raycast networking capture is not linked")
    if shutil.which("codex") and command_ok(["codex", "mcp", "get", "networking"]):
        report.ok("Codex networking MCP registration")
    else:
        report.warn("Codex networking MCP is not registered")

    inbox = networking_home / "inbox"
    pending = (
        [path for path in inbox.glob("*.md") if path.name != ".gitkeep"]
        if inbox.exists()
        else []
    )
    if pending:
        report.warn(f"{len(pending)} networking inbox note(s) pending")
    else:
        report.ok("networking inbox is empty")

    print("\n== environment ==")
    path_entries = os.environ.get("PATH", "").split(os.pathsep)
    duplicates = sorted(
        {entry for entry in path_entries if entry and path_entries.count(entry) > 1}
    )
    if duplicates:
        report.warn(f"PATH contains {len(duplicates)} duplicated entries")
    else:
        report.ok("PATH has no duplicated entries")
    codex_size = directory_size(home / ".codex")
    if codex_size > 2 * 1024**3:
        report.warn(f"~/.codex uses {codex_size / 1024**3:.1f} GiB")
    else:
        report.ok("~/.codex is below the 2 GiB warning budget")

    if not args.skip_git:
        print("\n== repositories ==")
        dirty = []
        for repository in discover_repositories(home / "Developer"):
            try:
                result = subprocess.run(
                    ["git", "-C", str(repository), "status", "--porcelain"],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=10,
                )
            except (OSError, subprocess.TimeoutExpired):
                continue
            if result.stdout.strip():
                dirty.append(repository)
                report.warn(f"dirty repository: {repository}")
        if not dirty:
            report.ok("Developer repositories are clean")

    print(f"\n{report.failures} failure(s), {report.warnings} warning(s)")
    return 1 if report.failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
