{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env PATH=/run/current-system/sw/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Users/ross/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin /opt/homebrew/bin/lavish-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "/usr/bin/env PATH=/run/current-system/sw/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Users/ross/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin /bin/bash '/Users/ross/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env PATH=/run/current-system/sw/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Users/ross/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin /Users/ross/.local/bin/notify --priority high --tag rotating_light --sound Glass --volume loud --repeat 2 \"Codex done\" \"A Codex turn is ready for review\"",
            "statusMessage": "Notifying captain",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
